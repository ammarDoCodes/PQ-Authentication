# Development-only settings. Copy to .env and replace every sample password.
QG_ENV=development
LISTEN_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://quantumgate:replace-this-local-password@localhost:5432/quantumgate?sslmode=disable
MIGRATION_DATABASE_URL=postgres://quantumgate_migrator:replace-this-migration-password@localhost:5432/quantumgate?sslmode=disable
CRYPTO_MODE=observe-only
RATE_LIMIT_HMAC_KEY=
# Leave empty unless explicitly exercising the in-memory DEVELOPMENT ONLY provider.
# No production KMS, HSM, Vault, or PKCS#11 provider is implemented.
KEY_PROVIDER=
KEY_PROVIDER_REQUIRED=false
POSTGRES_DB=quantumgate
POSTGRES_ADMIN_USER=quantumgate_admin
POSTGRES_ADMIN_PASSWORD=replace-this-admin-password
QG_APP_PASSWORD=replace-this-local-password
QG_MIGRATION_PASSWORD=replace-this-migration-password

# Optional local admin sign-in settings; leave unset to keep /v1 unavailable.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
OIDC_ALLOWED_HOSTS=
OIDC_REQUIRED_ACR=
OIDC_SIGNING_ALGS=RS256
OIDC_MAX_TOKEN_AGE=15m
IDENTITY_ALLOWED_HOSTS=
# Exact DNS hosts that tenant webhook destinations may use; private hosts are not supported.
WEBHOOK_ALLOWED_HOSTS=

# Optional TLS-terminating application gateway. Configure TLS_CERT_FILE,
# TLS_KEY_FILE, IDENTITY_ALLOWED_HOSTS, and mount a route file such as
# ops/gateway/routes.example.json. Production also requires an exact upstream allowlist.
# The gateway uses a dedicated listener port (development default: 127.0.0.1:8444).
# Production upstream URLs must be HTTPS and their exact DNS hosts allowlisted.
GATEWAY_LISTEN_ADDR=
GATEWAY_ROUTES_FILE=
GATEWAY_UPSTREAM_ALLOWED_HOSTS=

# Used only by qg-bootstrap after migrations. Values are deployment-specific.
BOOTSTRAP_TENANT_ID=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_ADMIN_ISSUER=
BOOTSTRAP_ADMIN_SUBJECT=
BOOTSTRAP_ENVIRONMENT_NAME=default
